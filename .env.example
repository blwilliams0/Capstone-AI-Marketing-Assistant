# Copy this file to .env.local (which is git-ignored) and fill in real values.
# NEVER commit .env.local. NEVER put real values in this file.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# "development" for local work. Anything else (including unset) is treated as production,
# and production refuses AUTH_MODE=mock.
NODE_ENV=development

# "supabase" (default, real sign-in) or "mock" (local development only; refused outside
# NODE_ENV=development/test). Mock mode lets you sign in as any role with no password.
AUTH_MODE=supabase

API_PORT=3000
# The ONLY browser origin allowed to call the API (CORS).
WEB_ORIGIN=http://localhost:5173
# Where the browser finds the API.
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API in the Supabase dashboard)
# ---------------------------------------------------------------------------
# Browser-safe values. These are compiled into the web app on purpose.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets. Never exposed to the browser. Never commit.
# ---------------------------------------------------------------------------
# Secret key: lets the server send staff invitations. Used by the API and bootstrap script.
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Postgres connection string (Supabase -> Connect -> pooler). Used by the API, worker and migrations.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000

# ---------------------------------------------------------------------------
# AI (SERVER-ONLY). Anthropic Console API key: https://console.anthropic.com
# A Claude Pro/Max chat subscription does NOT work here. Set a spend limit in the Console.
# Leave empty to run with the built-in mock AI (no cost).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# App-side monthly budget for AI requests, in US dollars. Requests stop when it is reached.
AI_MONTHLY_BUDGET_USD=25

# Qwen, AWS Bedrock and Meta are not used in V1.
