# Supabase Configuration
# Create a project at https://supabase.com and copy these values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Qwen API Configuration (Alibaba Cloud Model Studio)
# Create a US-scoped workspace at https://modelstudio.console.aliyun.com
QWEN_API_KEY=your-qwen-api-key-here
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# AWS Bedrock Configuration (for embeddings)
# Create an IAM user with Bedrock permissions
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=us-east-1

# Application Settings
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

# Session Settings
SESSION_SECRET=your-secret-key-here-change-in-production
SESSION_MAX_AGE_SECONDS=86400

# Cost Monitoring
QWEN_DAILY_TOKEN_LIMIT=100000
EMBEDDING_DAILY_LIMIT=1000

# Mock User (development only)
MOCK_USER_EMAIL=dev@example.com
MOCK_USER_NAME=Developer
MOCK_USER_ROLE=contributor
