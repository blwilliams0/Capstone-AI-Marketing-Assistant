{
  "name": "@the-pocket/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../../.env.local src/scripts/migrate.ts",
    "bootstrap-admin": "tsx --env-file-if-exists=../../.env.local src/scripts/bootstrap-admin.ts",
    "load-knowledge": "tsx --env-file-if-exists=../../.env.local src/scripts/load-knowledge.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@supabase/supabase-js": "^2.46.2",
    "@the-pocket/db": "*",
    "@the-pocket/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^5.1.0"
  }
}
