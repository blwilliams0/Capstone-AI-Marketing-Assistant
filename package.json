{
  "name": "the-pocket-ai-marketing-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based AI Marketing Assistant for The Pocket restaurant",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev -w @the-pocket/api",
    "dev:web": "npm run dev -w @the-pocket/web",
    "dev:worker": "npm run dev -w @the-pocket/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test --concurrency=1",
    "check:bundle": "node scripts/check-bundle.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,sql}\"",
    "db:migrate": "npm run migrate -w @the-pocket/api",
    "bootstrap-admin": "npm run bootstrap-admin -w @the-pocket/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": { "node": ">=24.0.0" },
  "packageManager": "npm@11.12.1"
}
