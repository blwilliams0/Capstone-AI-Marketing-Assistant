{
  "name": "the-pocket-ai-marketing-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based AI Marketing Assistant for The Pocket restaurant",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=\"!apps/worker\" --filter=\"!apps/web\"",
    "dev:api": "turbo run dev --filter=apps/api",
    "dev:web": "turbo run dev --filter=apps/web",
    "dev:worker": "turbo run dev --filter=apps/worker",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "cd db/migrations && supabase db push"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.0.0"
}
